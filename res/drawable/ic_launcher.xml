<?xml version="1.0" encoding="utf-8"?>
<!--
  车机浏览器 B — 启动图标（v2 重绘）

  上一版是一个"球 + 三条线"，在车里的小尺寸下更像一个加载转圈，识不出来是浏览器。
  这一版画的是一个抽象的**浏览器窗口**：圆角外框 + 顶部标题条 + 三个圆点 + 一条地址栏。
  单色线条在 48dp 和 192dp 下都能站得住。

  只用描边、不用位图：任意尺寸清晰。
  105 视框，内容控制在 10..98，四周留白。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 深色圆角底 -->
    <path
        android:fillColor="#0B0F14"
        android:pathData="M22,6 H86 A16,16 0 0 1 102,22 V86 A16,16 0 0 1 86,102 H22 A16,16 0 0 1 6,86 V22 A16,16 0 0 1 22,6 Z" />

    <!-- 窗口外框 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#22C55E"
        android:strokeWidth="5"
        android:strokeLineJoin="round"
        android:pathData="M30,30 H78 A8,8 0 0 1 86,38 V78 A8,8 0 0 1 78,86 H30 A8,8 0 0 1 22,78 V38 A8,8 0 0 1 30,30 Z" />

    <!-- 标题条分隔线 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#22C55E"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M22,44 H86" />

    <!-- 三个圆点（窗口按钮） -->
    <path
        android:fillColor="#22C55E"
        android:pathData="M34,37 m-3.2,0 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0" />
    <path
        android:fillColor="#22C55E"
        android:pathData="M45,37 m-3.2,0 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0" />
    <path
        android:fillColor="#22C55E"
        android:pathData="M56,37 m-3.2,0 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0" />

    <!-- 页面内容示意：三段横线，长度递减，标出"这是一页内容" -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#2F6B4A"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M32,58 H76" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#2F6B4A"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M32,68 H68" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#2F6B4A"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M32,78 H58" />
</vector>
