<?xml version="1.0" encoding="utf-8"?>
<!--
  车览 · 启动图标

  设计说明：
    外框 = 浏览器窗口（圆角矩形 + 标题条 + 两个窗口点）
    框内 = 一条地平线 + 一轮落日
    合起来是「在车里看世界」——比一颗抽象的球更容易一眼认出来是浏览器。

  纯矢量：108 视框，内容控制在 18..90，四周留白；
  线宽 4~5.5，在 48dp 的桌面图标和 192dp 的详情页里都站得住。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 深色圆角底 -->
    <path
        android:fillColor="#0B1017"
        android:pathData="M28,4 H80 A24,24 0 0 1 104,28 V80 A24,24 0 0 1 80,104 H28 A24,24 0 0 1 4,80 V28 A24,24 0 0 1 28,4 Z" />

    <!-- 窗口外框 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#22C55E"
        android:strokeWidth="5"
        android:strokeLineJoin="round"
        android:pathData="M30,26 H78 A9,9 0 0 1 87,35 V73 A9,9 0 0 1 78,82 H30 A9,9 0 0 1 21,73 V35 A9,9 0 0 1 30,26 Z" />

    <!-- 标题条 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1C6B45"
        android:strokeWidth="4"
        android:pathData="M21,42 H87" />

    <!-- 两个窗口点 -->
    <path
        android:fillColor="#22C55E"
        android:pathData="M29,34 m-2.4,0 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0" />
    <path
        android:fillColor="#22C55E"
        android:pathData="M38,34 m-2.4,0 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0" />

    <!-- 落日 -->
    <path
        android:fillColor="#22C55E"
        android:pathData="M62,54 m-6.5,0 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0" />

    <!-- 地平线 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#22C55E"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:pathData="M29,64 H79" />
</vector>
